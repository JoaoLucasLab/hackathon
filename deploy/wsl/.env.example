# WSL backup host settings. Copy to deploy/wsl/.env ON THE SERVER (git-ignored,
# never uploaded by push.sh) and fill in. Never commit a real key.

# Public URL Tailscale Funnel gives the web container: https://<machine>.<tailnet>.ts.net
# Used as FRONTEND_ORIGIN (CORS) by the backend.
PUBLIC_URL=https://change-me.tailnet-name.ts.net

# Postgres (created on the first start of an empty volume).
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app_db

# Server-only secrets. Generate with:  openssl rand -base64 32
ANTHROPIC_API_KEY=
DATA_KEY=
SESSION_SECRET=

# Model names (never hard-coded in code).
CLAUDE_MODEL_CHAT=claude-sonnet-5-5
CLAUDE_MODEL_BULK=claude-haiku-5-5

# Feature flags. Same names as on Render. Off unless the team turns them on.
FEATURE_AUDIT_UPLOAD=false
FEATURE_MENTORS=false
FEATURE_RELAXATION=false
# Days before an uploaded degree audit counts as old (AI-04).
AUDIT_MAX_AGE_DAYS=30

# Host ports (bound to 127.0.0.1 only; Tailscale forwards to them).
WEB_HOST_PORT=8080
API_HOST_PORT=8000
DB_HOST_PORT=5433

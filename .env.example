# Backend environment. Copy to `.env` (git-ignored) and fill in. Never commit a real key.
# Load it before starting the API, e.g.:  set -a; source .env; set +a

# Claude API key. Server only: it must never appear in frontend/ or in any VITE_* variable.
ANTHROPIC_API_KEY=

# Model names. Code reads these; never hard-code a model name.
CLAUDE_MODEL_CHAT=claude-sonnet-5-5
CLAUDE_MODEL_BULK=claude-haiku-5-5

# Sources the importers may call. Empty = zero outbound requests to BYU-Idaho. Keep it empty.
LIVE_SOURCES=

# Hosting (same names on Render and on the WSL backup host, deploy/wsl/.env.example).
# Postgres URL. Plain postgresql:// is fine; the backend picks the driver.
DATABASE_URL=
# Exact origin of the frontend, for CORS. Render: the static site URL. WSL: the ts.net URL.
FRONTEND_ORIGIN=
# Session cookie SameSite: none on Render (frontend and API on different sites), lax on WSL (one origin).
COOKIE_SAMESITE=none
# Secrets: generate with  openssl rand -base64 32
SESSION_SECRET=
DATA_KEY=

# Feature flags. Off unless the team turns them on (same names on Render and WSL).
FEATURE_AUDIT_UPLOAD=false
# Days before an uploaded degree audit counts as old and the student is asked for a fresh one.
AUDIT_MAX_AGE_DAYS=30

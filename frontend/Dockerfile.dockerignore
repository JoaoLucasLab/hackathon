# Used instead of the root .dockerignore when building frontend/Dockerfile
# (build context = repo root; the frontend tests import ../fixtures).
**
!frontend/**
!fixtures/*.json
!fixtures/audits/*/expected.json
frontend/node_modules
frontend/dist
frontend/openapi.json
frontend/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/.DS_Store

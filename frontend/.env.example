# Frontend build-time settings (Vite). No secrets here: everything VITE_* ends up in the bundle.
# Base URL of the backend. Empty means same origin (local dev uses the Vite proxy for /api).
VITE_API_BASE_URL=
# Shows the "Upload my audit" button. Off until AI-04 merges.
VITE_FEATURE_AUDIT_UPLOAD=false
# AI-07 / AI-08 conversational planner (one schedule in the chat, "My plan" tab).
# Must match the backend's FEATURE_CONVERSATIONAL_PLANNER. On Render, set it on the
# static site and rebuild; set FEATURE_CONVERSATIONAL_PLANNER on the web service.
VITE_FEATURE_CONVERSATIONAL_PLANNER=false
